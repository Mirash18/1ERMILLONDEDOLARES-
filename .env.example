# Copia este archivo como .env.local y llena los valores reales.
# .env.local NUNCA se sube a git (ver .gitignore) — solo vive en cada
# máquina/servidor donde corre el proyecto.

# --- Clerk (Fase 3) — quién eres ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/introduccion

# --- Admin (/admin) — correos separados por coma, sin espacios ---
ADMIN_EMAILS=

# --- Stripe — NO VIABLE para este proyecto (Stripe no opera con vendedores
# en Colombia, ver docs/ARQUITECTURA.md). El código sigue en el repo por si
# algún día aplica (empresa constituida en otro país), pero el cobro real va
# por MercadoPago. Mientras no estén puestas, /api/checkout y el webhook de
# Stripe simplemente no hacen nada (fallan en silencio).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- MercadoPago (Fase 3) — si estás al día con el pago ---
# Pendiente de integrar (en construcción, sept. 2026).
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- Cron diario (calentar caché del universo gratuito) ---
# La crea manualmente Alejo en Vercel — un valor aleatorio cualquiera. Vercel
# manda automáticamente "Authorization: Bearer <esto>" en cada invocación
# programada; sin él, la ruta del cron rechaza la petición.
CRON_SECRET=

# --- Redis/Upstash — caché de datos de mercado (no de suscripción) ---
# La crea sola la integración de Upstash en Vercel (Storage). En local no
# hace falta: sin estas llaves, el proyecto simplemente no cachea nada.
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=

# --- Proveedor de datos de mercado (Fase 2) — Twelve Data ---
# Clave de prueba por ahora (plan gratuito, uso interno/no público).
# Antes de salir a producción hay que subir a un plan con licencia de
# uso público ("display") — ver docs/ARQUITECTURA.md.
TWELVEDATA_API_KEY=

# --- Vimeo (Fase 4) ---
VIMEO_ACCESS_TOKEN=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# --- Base de datos (se define en Fase 1 avanzada) ---
DATABASE_URL=

# --- Autenticación (se define en Fase 1 avanzada) ---
AUTH_SECRET=
