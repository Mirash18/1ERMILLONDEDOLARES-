# Copia este archivo como .env.local y llena los valores reales.
# .env.local NUNCA se sube a git (ver .gitignore) — solo vive en cada
# máquina/servidor donde corre el proyecto.

# --- Clerk (Fase 3) — quién eres ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Stripe (Fase 3) — si estás al día con el pago ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Proveedor de datos de mercado (Fase 2) — Twelve Data ---
# Clave de prueba por ahora (plan gratuito, uso interno/no público).
# Antes de salir a producción hay que subir a un plan con licencia de
# uso público ("display") — ver docs/ARQUITECTURA.md.
TWELVEDATA_API_KEY=

# --- Vimeo (Fase 4) ---
VIMEO_ACCESS_TOKEN=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# --- Base de datos (se define en Fase 1 avanzada) ---
DATABASE_URL=

# --- Autenticación (se define en Fase 1 avanzada) ---
AUTH_SECRET=
